# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# build-time generated image derivatives (regenerated by scripts/generate-image-derivatives.mjs)
/public/img/derivatives/

# production
/build

# local source/conversion videos; production playback is hosted on YouTube.
# Kept outside /public/ (not just gitignored) so the Next.js static export
# (`output: "export"` copies the whole public/ tree verbatim, ignoring .git)
# never picks it up into out/, even from an untracked local working tree.
/video-source/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel
.cloudflare/

# wrangler local state (npm run preview)
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
